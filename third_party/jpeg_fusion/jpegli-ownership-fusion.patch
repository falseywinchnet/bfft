--- /dev/null
+++ b/lib/jpegli/ownership_trellis.cc
@@ -0,0 +1,233 @@
+// Copyright (c) the JPEG XL Project Authors.
+//
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "lib/jpegli/ownership_trellis.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+#include "lib/jpegli/common_internal.h"
+#include "lib/jpegli/encode_internal.h"
+#include "lib/jpegli/memory_manager.h"
+
+namespace jpegli {
+namespace {
+
+using DepthTable = std::array<int, 256>;
+
+DepthTable SymbolDepths(const JHUFF_TBL* table) {
+  DepthTable depth;
+  depth.fill(0);
+  if (table != nullptr) {
+    size_t offset = 0;
+    for (int bits = 1; bits <= 16; ++bits) {
+      for (int i = 0; i < table->bits[bits]; ++i) {
+        depth[table->huffval[offset++]] = bits;
+      }
+    }
+  }
+  // Defensive fixed costs make the experimental path usable if an embedding
+  // application has not installed default Huffman tables yet.
+  if (depth[0] == 0) depth[0] = 4;
+  if (depth[0xf0] == 0) depth[0xf0] = 11;
+  for (int run = 0; run < 16; ++run) {
+    for (int category = 1; category < 16; ++category) {
+      const int symbol = 16 * run + category;
+      if (depth[symbol] == 0) depth[symbol] = 8 + run / 4;
+    }
+  }
+  return depth;
+}
+
+DepthTable ComponentDepths(j_compress_ptr cinfo, int component) {
+  jpeg_comp_master* m = cinfo->master;
+  const JHUFF_TBL* table = nullptr;
+  int best_span = -1;
+  if (m->huffman_tables != nullptr && m->context_map != nullptr) {
+    for (int scan = 0; scan < cinfo->num_scans; ++scan) {
+      const jpeg_scan_info& si = cinfo->scan_info[scan];
+      if (si.Ah != 0 || si.Ss == 0) continue;
+      for (int j = 0; j < si.comps_in_scan; ++j) {
+        if (si.component_index[j] != component) continue;
+        const int span = si.Se - si.Ss + 1;
+        if (span > best_span) {
+          const int context = m->ac_ctx_offset[scan] + j;
+          table = &m->huffman_tables[m->context_map[context]];
+          best_span = span;
+        }
+      }
+    }
+  }
+  if (table == nullptr) {
+    const jpeg_component_info& comp = cinfo->comp_info[component];
+    table = cinfo->ac_huff_tbl_ptrs[comp.ac_tbl_no];
+  }
+  return SymbolDepths(table);
+}
+
+int Category(int value) {
+  unsigned magnitude = static_cast<unsigned>(std::abs(value));
+  int result = 0;
+  while (magnitude != 0) {
+    ++result;
+    magnitude >>= 1;
+  }
+  return result;
+}
+
+double BlockBits(const JCOEF* block, const DepthTable& depth) {
+  int last = 63;
+  while (last > 0 && block[last] == 0) --last;
+  double bits = 0.0;
+  int run = 0;
+  for (int k = 1; k <= last; ++k) {
+    if (block[k] == 0) {
+      ++run;
+      continue;
+    }
+    while (run >= 16) {
+      bits += depth[0xf0];
+      run -= 16;
+    }
+    const int category = Category(block[k]);
+    bits += depth[16 * run + category] + category;
+    run = 0;
+  }
+  if (last < 63) bits += depth[0];
+  return bits;
+}
+
+double OptimizeBlock(const float* qcoeff, const float* permission,
+                     const DepthTable& depth, float rate_lambda,
+                     float ownership_weight, float edge_weight,
+                     float channel_weight, JCOEF* block) {
+  constexpr int kPositions = 64;
+  constexpr double kInfinity = std::numeric_limits<double>::infinity();
+  std::array<double, kPositions> cost;
+  std::array<double, kPositions> next;
+  std::vector<std::array<int8_t, kPositions>> back_run(kPositions);
+  std::vector<std::array<JCOEF, kPositions>> back_value(kPositions);
+  cost.fill(kInfinity);
+  cost[0] = 0.0;
+
+  for (int position = 1; position < kPositions; ++position) {
+    next.fill(kInfinity);
+    const double source = qcoeff[position];
+    const int natural = kJPEGNaturalOrder[position];
+    const int u = natural / DCTSIZE;
+    const int v = natural % DCTSIZE;
+    const double edge_scale = channel_weight *
+        (1.0 + edge_weight * (u * u + v * v) / 98.0);
+    const double stable = std::exp(-4.0 * permission[position]);
+    const double zero_distortion = edge_scale * source * source *
+        (1.0 + ownership_weight * stable);
+    for (int run = 0; run < position; ++run) {
+      if (!std::isfinite(cost[run])) continue;
+      if (cost[run] + zero_distortion < next[run + 1]) {
+        next[run + 1] = cost[run] + zero_distortion;
+        back_run[position][run + 1] = run;
+        back_value[position][run + 1] = 0;
+      }
+
+      const int sign = source < 0.0 ? -1 : 1;
+      const double magnitude = std::abs(source);
+      int zrl_run = run;
+      double run_rate = 0.0;
+      while (zrl_run >= 16) {
+        run_rate += depth[0xf0];
+        zrl_run -= 16;
+      }
+      for (int category = 1; category < 16; ++category) {
+        const int low = 1 << (category - 1);
+        const int high = (1 << category) - 1;
+        const int candidate_magnitude = std::clamp(
+            static_cast<int>(std::lround(magnitude)), low, high);
+        const int candidate = sign * candidate_magnitude;
+        const int symbol = 16 * zrl_run + category;
+        const double rate = run_rate + depth[symbol] + category;
+        const double delta = source - candidate;
+        const double candidate_cost = cost[run] +
+            edge_scale * delta * delta + rate_lambda * rate;
+        if (candidate_cost < next[0]) {
+          next[0] = candidate_cost;
+          back_run[position][0] = run;
+          back_value[position][0] = static_cast<JCOEF>(candidate);
+        }
+      }
+    }
+    cost = next;
+  }
+
+  int best_run = 0;
+  double best_cost = cost[0];
+  for (int run = 1; run < kPositions; ++run) {
+    const double terminal = cost[run] + rate_lambda * depth[0];
+    if (terminal < best_cost) {
+      best_cost = terminal;
+      best_run = run;
+    }
+  }
+  for (int position = kPositions - 1; position >= 1; --position) {
+    block[position] = back_value[position][best_run];
+    best_run = back_run[position][best_run];
+  }
+  return best_cost;
+}
+
+}  // namespace
+
+void ApplyOwnershipTrellis(j_compress_ptr cinfo) {
+  jpeg_comp_master* m = cinfo->master;
+  if (m->trellis_rate_lambda <= 0.0f || m->coeff_buffers == nullptr) return;
+  m->trellis_blocks = 0;
+  m->trellis_nonzeros_before = 0;
+  m->trellis_nonzeros_after = 0;
+  m->trellis_bits_before = 0.0;
+  m->trellis_bits_after = 0.0;
+  m->trellis_objective = 0.0;
+  for (int c = 0; c < cinfo->num_components; ++c) {
+    jpeg_component_info* comp = &cinfo->comp_info[c];
+    const DepthTable depth = ComponentDepths(cinfo, c);
+    for (JDIMENSION by = 0; by < comp->height_in_blocks; ++by) {
+      JBLOCKARRAY blocks = GetBlockRow(cinfo, c, by);
+      for (JDIMENSION bx = 0; bx < comp->width_in_blocks; ++bx) {
+        JCOEF* block = &blocks[0][bx][0];
+        const float* qcoeff = m->trellis_qcoeff[c] +
+            (by * comp->width_in_blocks + bx) * DCTSIZE2;
+        std::array<float, DCTSIZE2> natural_permission{};
+        std::array<float, DCTSIZE2> permission{};
+        if (m->dead_zone_provider != nullptr) {
+          m->dead_zone_provider(m->dead_zone_opaque, c, bx, by,
+                                natural_permission.data());
+          for (int k = 0; k < DCTSIZE2; ++k) {
+            permission[k] = std::max(
+                0.0f, natural_permission[kJPEGNaturalOrder[k]]);
+          }
+        }
+        m->trellis_bits_before += BlockBits(block, depth);
+        for (int k = 1; k < DCTSIZE2; ++k) {
+          if (block[k] != 0) ++m->trellis_nonzeros_before;
+        }
+        m->trellis_objective += OptimizeBlock(
+            qcoeff, permission.data(), depth, m->trellis_rate_lambda,
+            m->trellis_ownership_weight, m->trellis_edge_weight,
+            c == 0 ? m->trellis_luma_weight : m->trellis_chroma_weight,
+            block);
+        m->trellis_bits_after += BlockBits(block, depth);
+        for (int k = 1; k < DCTSIZE2; ++k) {
+          if (block[k] != 0) ++m->trellis_nonzeros_after;
+        }
+        ++m->trellis_blocks;
+      }
+    }
+  }
+}
+
+}  // namespace jpegli
