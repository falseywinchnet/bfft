+  const jpeg_compress_struct* cinfo;
+};
+
+void OwnershipDeadZoneProvider(void* opaque, int component,
+                               JDIMENSION block_x, JDIMENSION block_y,
+                               float* thresholds) {
+  const auto* context = static_cast<const DeadZoneProviderContext*>(opaque);
+  const JpegDeadZoneField& field = *context->field;
+  const jpeg_compress_struct& cinfo = *context->cinfo;
+  if (component < 0 || component >= 3 || field.xsize_blocks == 0 ||
+      field.ysize_blocks == 0) {
+    return;
+  }
+  const jpeg_component_info& comp = cinfo.comp_info[component];
+  const size_t scale_x = cinfo.max_h_samp_factor / comp.h_samp_factor;
+  const size_t scale_y = cinfo.max_v_samp_factor / comp.v_samp_factor;
+  const size_t x0 = std::min<size_t>(block_x * scale_x, field.xsize_blocks);
+  const size_t y0 = std::min<size_t>(block_y * scale_y, field.ysize_blocks);
+  const size_t x1 = std::min(x0 + scale_x, field.xsize_blocks);
+  const size_t y1 = std::min(y0 + scale_y, field.ysize_blocks);
+  if (x0 == x1 || y0 == y1) return;
+  const size_t plane = field.xsize_blocks * field.ysize_blocks * DCTSIZE2;
+  const float scale = 1.0f / ((x1 - x0) * (y1 - y0));
+  for (size_t y = y0; y < y1; ++y) {
+    for (size_t x = x0; x < x1; ++x) {
+      const size_t offset = component * plane +
+                            (y * field.xsize_blocks + x) * DCTSIZE2;
+      for (size_t k = 0; k < DCTSIZE2; ++k) {
+        thresholds[k] += field.thresholds[offset + k] * scale;
+      }
+    }
+  }
+}
