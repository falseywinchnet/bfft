+bool LoadDeadZoneField(const std::string& path,
+                       jpegli::extras::JpegSettings* settings) {
+  if (path.empty()) return true;
+  std::vector<uint8_t> bytes;
+  if (!ReadFile(path.c_str(), &bytes) || bytes.size() < 16 ||
+      memcmp(bytes.data(), "JLDZ", 4) != 0) {
+    fprintf(stderr, "Invalid dead-zone field %s\n", path.c_str());
+    return false;
+  }
+  const uint32_t version = LoadLE32(bytes.data() + 4);
+  const uint32_t xsize = LoadLE32(bytes.data() + 8);
+  const uint32_t ysize = LoadLE32(bytes.data() + 12);
+  const size_t count = static_cast<size_t>(3) * xsize * ysize * DCTSIZE2;
+  if (version != 1 || xsize == 0 || ysize == 0 ||
+      count > (bytes.size() - 16) / sizeof(float) ||
+      bytes.size() != 16 + count * sizeof(float)) {
+    fprintf(stderr, "Malformed dead-zone field %s\n", path.c_str());
+    return false;
+  }
+  auto field = std::make_shared<jpegli::extras::JpegDeadZoneField>();
+  field->xsize_blocks = xsize;
+  field->ysize_blocks = ysize;
+  field->thresholds.resize(count);
+  memcpy(field->thresholds.data(), bytes.data() + 16,
+         count * sizeof(float));
+  settings->dead_zone_field = std::move(field);
+  return true;
+}
